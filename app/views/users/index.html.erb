<p><%= notice %></p>

<h1>ユーザ一覧</h1>
<ul>
  <% @users.each do |u| %>
    <li>
      <%= link_to u.uid, user_path(u) %>, password_digest: <%= u.password_digest %>
      <%= link_to '削除', user_path(u), data: { turbo_method: :delete, turbo_confirm: '削除しますか？' } %>
    </li>
  <% end %>
</ul>
<%= link_to '新規登録', new_user_path %>

<p><%= link_to 'ツイート一覧へ', root_path %></p>