<h1>ユーザ登録</h1>

<% if @user.errors.any? %>
  <ul>
    <% @user.errors.full_messages.each do |m| %>
      <li><%= m %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |f| %>
  <p>ユーザID：<%= f.text_field :uid %></p>
  <p>パスワード：<%= f.password_field :pass, value: "" %></p>
  <%= f.submit "登録" %>
<% end %>
<%= link_to '戻る', users_path %>